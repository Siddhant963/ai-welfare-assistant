# Copy this file to .env and fill in your real Neon PostgreSQL connection string.
# Never commit .env — it is gitignored.

# Pooled connection (used by the app / Prisma Client at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: Neon's direct (non-pooled) connection, used for migrations.
# If you only have one connection string, set both to the same value.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Groq API key for AI triage (server-side only — never sent to the browser).
# Get one at https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: override the Groq-hosted model used for triage. Defaults to
# openai/gpt-oss-120b if unset. Groq's hosted model catalog changes over
# time — check https://console.groq.com/docs/models if this stops working.
GROQ_MODEL="openai/gpt-oss-120b"
